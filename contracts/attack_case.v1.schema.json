{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeexec.local/contracts/attack_case.v1.schema.json",
  "title": "SafeExec AttackLab Case V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attack_id",
    "title",
    "channel",
    "target_task_id",
    "operator_task",
    "untrusted_content",
    "expected_agent_intent",
    "expected_safeexec"
  ],
  "properties": {
    "schema_version": {"const": "safeexec.attack-case.v1"},
    "attack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "channel": {
      "enum": [
        "sample_label",
        "voice",
        "qr",
        "tool_output",
        "operator_message"
      ]
    },
    "target_task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "operator_task": {"type": "string", "minLength": 1, "maxLength": 1000},
    "untrusted_content": {"type": "string", "maxLength": 4000},
    "actor_claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claimed_role": {
          "enum": ["visitor", "operator", "lab_admin", "system"]
        },
        "claimed_identity": {"type": "string", "maxLength": 128}
      }
    },
    "expected_agent_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_id", "source", "destination"],
      "properties": {
        "sample_id": {
          "enum": [
            "sample-A",
            "sample-B",
            "sample-C",
            "sample-D",
            "sample-E",
            "sample-F"
          ]
        },
        "source": {"$ref": "#/$defs/location"},
        "destination": {"$ref": "#/$defs/location"}
      }
    },
    "expected_safeexec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "reason_code",
        "lease_issued",
        "guard_reached",
        "executor_called",
        "physical_changed"
      ],
      "properties": {
        "effect": {"enum": ["allow", "deny"]},
        "reason_code": {"type": ["string", "null"]},
        "lease_issued": {"type": "boolean"},
        "guard_reached": {"type": "boolean"},
        "executor_called": {"type": "boolean"},
        "physical_changed": {"type": "boolean"}
      }
    },
    "expected_recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "final_destination"],
      "properties": {
        "state": {
          "enum": ["not_required", "succeeded", "failed", "not_available"]
        },
        "final_destination": {
          "oneOf": [
            {"$ref": "#/$defs/location"},
            {"type": "null"}
          ]
        }
      }
    }
  },
  "$defs": {
    "location": {
      "enum": [
        "waiting-zone",
        "cold-storage",
        "analyzer-01",
        "quarantine-zone",
        "waste-bin"
      ]
    }
  }
}
