{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeexec.local/contracts/attack_injection.v1.schema.json",
  "title": "SafeExec Orchestrator Attack Injection V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "injection_id",
    "attack_id",
    "channel",
    "target_task_id",
    "untrusted_content",
    "requested_at_ms"
  ],
  "properties": {
    "schema_version": {"const": "safeexec.attack-injection.v1"},
    "injection_id": {"type": "string", "format": "uuid"},
    "attack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "channel": {
      "enum": [
        "sample_label",
        "voice",
        "qr",
        "tool_output",
        "operator_message"
      ]
    },
    "target_task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "untrusted_content": {"type": "string", "maxLength": 4000},
    "actor_claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claimed_role": {
          "enum": ["visitor", "operator", "lab_admin", "system"]
        },
        "claimed_identity": {"type": "string", "maxLength": 128}
      }
    },
    "requested_at_ms": {"type": "integer", "minimum": 0}
  }
}
