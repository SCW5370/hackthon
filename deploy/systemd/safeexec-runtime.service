[Unit]
Description=SafeExec zero-trust execution Runtime
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=safeexec-runtime
Group=safeexec-runtime
WorkingDirectory=/opt/safeexec
Environment=SAFEEXEC_ROOT=/opt/safeexec
EnvironmentFile=-/etc/safeexec/runtime.env
ExecStart=/opt/safeexec/scripts/run_x5_runtime.sh
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
