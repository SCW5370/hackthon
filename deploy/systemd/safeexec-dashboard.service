[Unit]
Description=SafeExec edge management console
After=network-online.target safeexec-runtime.service safeexec-orchestrator.service
Wants=network-online.target
Requires=safeexec-runtime.service safeexec-orchestrator.service

[Service]
Type=simple
User=safeexec-console
Group=safeexec-console
WorkingDirectory=/opt/safeexec
Environment=SAFEEXEC_ROOT=/opt/safeexec
EnvironmentFile=-/etc/safeexec/dashboard.env
ExecStart=/opt/safeexec/scripts/run_x5_dashboard.sh
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
